{
    "name": "synerdy/modsx",
    "description": "Convention-based modules for Laravel: organise, back up, version and restore parts of your application using a directory-name prefix.",
    "keywords": ["laravel", "modules", "backup", "restore", "versioning", "convention"],
    "homepage": "https://github.com/Synerdy/modsx",
    "license": "MIT",
    "authors": [
        {
            "name": "Synerdy",
            "email": "szajens@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "composer-runtime-api": "^2.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/prompts": "^0.3 || ^1.0",
        "symfony/finder": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.18",
        "league/commonmark": "^2.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Modsx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modsx\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modsx\\ModsxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse",
        "docs": "php docs/build.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
